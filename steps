import pyttsx3
import threading

class AudioEngine:
    def __init__(self):
        self.engine = pyttsx3.init()
        self.is_speaking = False

    def _speak(self, text):
        self.is_speaking = True
        self.engine.say(text)
        self.engine.runAndWait()
        self.is_speaking = False

    def speak_text(self, text):
        if not self.is_speaking:
            threading.Thread(target=self._speak, args=(text,), daemon=True).start()



            File 2: src/detector.py

            import cv2
import numpy as np

class ObjectDetector:
    def __init__(self, cfg_path, weights_path, names_path):
        self.net = cv2.dnn.readNetFromDarknet(cfg_path, weights_path)
        self.net.setPreferableBackend(cv2.dnn.DNN_BACKEND_OPENCV)
        self.net.setPreferableTarget(cv2.dnn.DNN_TARGET_CPU)
        self.output_layers = self.net.getUnconnectedOutLayersNames()
        with open(names_path, 'r') as f:
            self.classes = [line.strip() for line in f.readlines()]

    def detect(self, frame, conf_threshold=0.4, nms_threshold=0.3):
        height, width = frame.shape[:2]
        blob = cv2.dnn.blobFromImage(frame, 1/255.0, (416, 416), swapRB=True, crop=False)
        self.net.setInput(blob)
        layer_outputs = self.net.forward(self.output_layers)

        boxes, confidences, class_ids = [], [], []
        for output in layer_outputs:
            for detection in output:
                scores = detection[5:]
                class_id = np.argmax(scores)
                confidence = scores[class_id]
                if confidence > conf_threshold:
                    center_x = int(detection[0] * width)
                    center_y = int(detection[1] * height)
                    w = int(detection[2] * width)
                    h = int(detection[3] * height)
                    x = int(center_x - w / 2)
                    y = int(center_y - h / 2)
                    boxes.append([x, y, w, h])
                    confidences.append(float(confidence))
                    class_ids.append(class_id)

        indices = cv2.dnn.NMSBoxes(boxes, confidences, conf_threshold, nms_threshold)
        detections = []
        if len(indices) > 0:
            for i in indices.flatten():
                detections.append({"box": boxes[i], "confidence": confidences[i], "class": self.classes[class_ids[i]]})
        return detections


        File 3: src/main.py


        import cv2
from detector import ObjectDetector
from text_to_speech import AudioEngine

def calculate_direction(box, frame_width):
    x, _, w, _ = box
    center_x = x + (w / 2)
    if center_x < frame_width / 3:
        return "on your left"
    elif center_x > (2 * frame_width) / 3:
        return "on your right"
    else:
        return "straight ahead"

def main():
    detector = ObjectDetector("model/yolov4-tiny.cfg", "model/yolov4-tiny.weights", "model/coco.names")
    audio = AudioEngine()
    cap = cv2.VideoCapture(0)

    while True:
        ret, frame = cap.read()
        if not ret: break
        frame_width = frame.shape[1]
        results = detector.detect(frame)
        detected_items = []

        for item in results:
            x, y, w, h = item["box"]
            label = item["class"]
            direction = calculate_direction(item["box"], frame_width)
            cv2.rectangle(frame, (x, y), (x + w, y + h), (0, 255, 0), 2)
            cv2.putText(frame, label, (x, y - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)
            detected_items.append(f"{label} {direction}")

        if detected_items:
            audio.speak_text(", and ".join(detected_items))

        cv2.imshow("Intelligent Vision Assistant Stream", frame)
        if cv2.waitKey(1) & 0xFF == ord('q'): break

    cap.release()
    cv2.destroyAllWindows()

if __name__ == "__main__":
    main()

